package com.example.demo.dao;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Repository;

import com.example.demo.dto.MyUser;

@Repository
public class MyUserDao {

    private final JdbcTemplate jt;           // 필드는 클래스 바로 아래

    public MyUserDao(JdbcTemplate jt) {      // 매개변수에는 private 없이
        this.jt = jt;
    }

    public void insert(MyUser dto) {
        String sql = "INSERT INTO myuser (userid, username) VALUES (?, ?)";
        jt.update(sql, dto.getUserid(), dto.getUsername());
    }
}
