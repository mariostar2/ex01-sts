package com.example.demo;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;

import jakarta.servlet.http.HttpServletRequest;
import lombok.extern.slf4j.Slf4j;

@Slf4j // 로그 보여주는 어노테이션 (logging)
@Controller //
public class MyController {
	@Autowired
	Printer p ;

	MyController(Printer p) {
		this.p = p;
	}
	
	@RequestMapping("/")
	public String root() {

		p.print("hello~~~");
		
		return "index";
	}

	// 요청주소
	@GetMapping("/a")
	public String test1() {
		return "test1";
	}
	//Http 방식
	@GetMapping("/b")
	public String test3(HttpServletRequest request) {
		String msg = request.getParameter("msg");
		System.out.println(msg);
		return "test2";
	}
	//RequestParam
	@GetMapping("/c")
	public String test2(Model model, @RequestParam("msg") String param) {
		System.out.println(param);
		log.info("파라미터 :" + param);
		model.addAttribute("msg", param);

		return "test2";
	}

	//커맨드 객체 사용
	@PostMapping("/d")
	public String df(Model model, Message msg) {
		model.addAttribute("message" , msg);
		System.out.println("d요청 처리....." + msg);
		return "test3";
	}
	
	//PathVariable 방식
	@GetMapping("/test4/{userid}/{name}")
	public String pathVarible(@PathVariable("userid")String userid, @PathVariable("name") String name, Model model) {
		model.addAttribute("userid",userid);
		model.addAttribute("name",name);
		return "test4";
	}
	
	
	@GetMapping("/test5")
	public String redirect() {
		System.out.println("redirect Test... 요청은 test5인데 주소창은 b라고 나오는 것인가요? ");
		return "redirect:/b";
	}
	
	
	
}
