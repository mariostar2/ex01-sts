<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
<h1>Test3</h1>
<hr>
<ul>
	<li>이름: ${message.name}</li>
	<li>내용: ${message.msg}</li>
	<li>취미: ${message.hobbies[0]}</li>
	
	<c:forEach var ="s" items="${message.hobbies}">
		<li>취미:${s}<li>
	</c:forEach>
	<c:forEach var="i" begin="0" end="${message.hobbies.length}" step="1">
		<p>${message.hobbies[i] }</p>
	</c:forEach>
</ul>	

</body>
</html>