<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
    
<mapper namespace="com.example.demo.dao.SimpleDao">
	<select id= "list" resultType="com.example.demo.dto.SimpleDto">
		SELECT * FROM simple_abs ORDER BY id ASC
	</select>
	
	<select id="view" resultType="com.example.demo.dto.SimpleDto">
		SELECT * FROM simple_abs  WHERE id =${id}
	</select>
	<insert id="write">
		INSERT INTO simple_abs(writer,title,content) 
		VALUES(#{s.writer},#{s.title},#{s.content})
	</insert>
	<update id ="update">
		UPDATE simple_abs SET title= #{s.title} ,content =#{s.content}
		WHERE  id = #{s.id}
	</update>
</mapper>