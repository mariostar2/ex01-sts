<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
    
 <mapper namespace="com.example.demo.dao.BoardDao">
 	<select id="list" resultType="com.example.demo.dto.BoardDto">
 		SELECT pid,bid,title,content,createdat,updatedat FROM user_board order by bid asc
 	</select>
 	<insert id="boardWrite">
 		INSERT INTO user_board (pid,title,content)
 		VALUES(#{s.pid},#{s.title},#{s.content})
 	</insert>
 	
 	<select id= "view" resultType="com.example.demo.dto.BoardDto">
 		SELECT * FROM user_board WHERE bid =#{bid}
 	</select>
 	
 	<update id ="boardUpdate">
 		UPDATE user_board SET title =#{s.title} , content = #{s.content}
 		WHERE bid = #{s.bid}
 	</update>
 	
 	<delete id ="boardDelete">
 		DELETE FROM user_board Where bid = #{bid}
 	</delete>
 </mapper>